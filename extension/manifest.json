{
  "manifest_version": 3,
  "name": "Adalove Modern UI",
  "version": "1.2.0",
  "description": "Importa suas notas do Adalove para o GradesInteli e oferece uma UI alternativa para o Adalove.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://adalove.inteli.edu.br/*",
    "https://apiv2.inteli.edu.br/*",
    "https://www.gradesinteli.com/*",
    "https://gradesinteli.com/*",
    "http://localhost/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-interceptor.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-boot.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "adalove-content.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ],
      "js": [
        "dist/adalove-ui.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://www.gradesinteli.com/*",
        "https://gradesinteli.com/*",
        "http://localhost/*"
      ],
      "js": [
        "grades-content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "fonts/*.woff2",
        "logos/*.png"
      ],
      "matches": [
        "https://adalove.inteli.edu.br/*"
      ]
    }
  ]
}
